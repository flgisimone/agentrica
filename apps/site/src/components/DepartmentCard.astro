---
import type { Department } from "@agentrica/catalog";

interface Props {
  department: Department;
}

const { department: d } = Astro.props;
const team = d.agents.slice(1);
---

<article class="card" data-dept={d.code} aria-labelledby={`reparto-${d.code}`}>
  <header class="card__head">
    <p class="card__code code">{d.code}</p>
    <h3 id={`reparto-${d.code}`}>{d.name}</h3>
    <p class="card__count">{d.agents.length} agenti</p>
  </header>

  <p class="card__summary">{d.summary}</p>

  <div class="card__director">
    <p class="card__label">Direttore</p>
    <p>
      <span class="code card__star">{d.director.id} · {d.director.star}</span>
      <span class="card__role">{d.director.role}</span>
    </p>
  </div>

  <details class="card__team">
    <summary>Gli altri {team.length} agenti</summary>
    <ul>
      {
        team.map((a) => (
          <li>
            <span class="code card__star">{a.id} · {a.star}</span>
            <span class="card__role">{a.role}</span>
          </li>
        ))
      }
    </ul>
  </details>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius);
  }

  .card__head {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-1) var(--space-4);
    align-items: baseline;
  }

  .card__code {
    grid-column: 1 / -1;
    color: var(--accent);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .card__head h3 {
    font-size: 1.375rem;
  }

  .card__count {
    color: var(--text-muted);
    font-size: 0.9375rem;
    white-space: nowrap;
  }

  .card__summary {
    color: var(--text-muted);
  }

  .card__director {
    padding: var(--space-3) var(--space-4);
    background: var(--surface-raised);
    border-radius: calc(var(--radius) - 0.25rem);
  }

  .card__label {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .card__star {
    display: block;
    color: var(--accent);
    font-weight: 600;
  }

  .card__role {
    display: block;
    font-size: 0.9375rem;
  }

  .card__team {
    margin-top: auto;
    border-top: 1px solid var(--border);
    padding-top: var(--space-3);
  }

  .card__team summary {
    cursor: pointer;
    font-weight: 600;
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    list-style: none;
  }

  .card__team summary::-webkit-details-marker {
    display: none;
  }

  /* con display: flex il triangolo nativo sparisce: l'indicatore dice che la voce si apre */
  .card__team summary::after {
    content: "+";
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--accent);
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .card__team[open] summary::after {
    content: "−";
  }

  .card__team summary:hover::after {
    border-color: var(--accent);
  }

  .card__team ul {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
</style>
