{
  "name": "agentrica",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p packages/catalog && tsc -p packages/mcp && tsc -p .",
    "lint": "eslint",
    "test": "node --test packages/catalog/src/*.test.ts packages/mcp/src/*.test.ts scripts/*.test.ts",
    "stats": "node scripts/stats.ts",
    "verify": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
