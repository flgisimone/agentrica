{
  "name": "agentrica",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @agentrica/site",
    "build": "npm run build -w @agentrica/site",
    "typecheck": "tsc -p packages/catalog && tsc -p packages/mcp && tsc -p . && npm run typecheck -w @agentrica/site",
    "lint": "eslint",
    "test": "node --test packages/catalog/src/*.test.ts packages/mcp/src/*.test.ts apps/site/src/lib/*.test.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "verify:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "typescript": "6.0.3"
  }
}
