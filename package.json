{
  "name": "agentrica",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @agentrica/site",
    "build": "npm run build -w @agentrica/site",
    "typecheck": "tsc -p packages/catalog && npm run typecheck -w @agentrica/site",
    "lint": "eslint",
    "test": "node --test packages/catalog/src/*.test.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
